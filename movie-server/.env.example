PORT=5000
NODE_ENV=development
# Single origin (kept for backward compatibility)
CLIENT_URL=http://localhost:3000
# Comma-separated allowed origins for CORS (recommended in production)
CLIENT_URLS=http://localhost:3000,https://violetuz.vercel.app
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/violetPlay?retryWrites=true&w=majority&appName=backend

# Auth + Brevo (Render env vars)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=verified-sender@yourdomain.com
BREVO_SENDER_NAME=Violet
