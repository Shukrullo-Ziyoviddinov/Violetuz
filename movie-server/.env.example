PORT=5000
NODE_ENV=development
# Single origin (kept for backward compatibility)
CLIENT_URL=http://localhost:3000
# Comma-separated allowed origins for CORS (recommended in production)
CLIENT_URLS=http://localhost:3000,https://violetuz.vercel.app
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/violetPlay?retryWrites=true&w=majority&appName=backend

# Auth + Brevo (Render env vars)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
# Cookie auth: CLIENT_URL / CLIENT_URLS must match frontend origin exactly (credentials CORS)
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=verified-sender@yourdomain.com
BREVO_SENDER_NAME=Violet

# Cloudflare R2 (Object Storage) — never commit real secrets
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Optional if R2_ACCOUNT_ID is set (defaults to https://<ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=violetplay
# Custom domain for public media URLs (no trailing slash)
R2_PUBLIC_URL=https://cdn.violetplay.uz

# R2 bucket CORS (Cloudflare Dashboard → R2 → violetplay → Settings → CORS policy).
# Required for browser direct PUT (avatar/admin). Paste JSON like:
# [
#   {
#     "AllowedOrigins": [
#       "http://localhost:3000",
#       "http://127.0.0.1:3000",
#       "https://violetuz.vercel.app"
#     ],
#     "AllowedMethods": ["GET", "PUT", "HEAD"],
#     "AllowedHeaders": ["Content-Type", "Content-Length", "Cache-Control"],
#     "ExposeHeaders": ["ETag"],
#     "MaxAgeSeconds": 3600
#   }
# ]
# Add every production frontend origin you use. Do NOT use "*" with credentialed apps if avoidable.
# Custom domain (cdn.violetplay.uz) is for public GET of objects; CORS above is for the S3 API upload endpoint.

# Catalog upload escape hatch — DEV ONLY.
# true = any logged-in user may presign img/video/… (dangerous).
# Production: always ignored; catalog folders require admin role only.
# Render/Railway: set NODE_ENV=production and keep this false (or omit).
R2_ALLOW_CATALOG_UPLOAD=false

# Admin bootstrap (comma-separated). On login/me these accounts get role=admin.
ADMIN_EMAILS=you@example.com
ADMIN_USERNAMES=

# One-time media migration (Variant D):
#   npm run migrate:media-to-r2:dry
#   npm run migrate:media-to-r2
# Uploads my-movie/public/{img,video,music} → R2 keys img/|video/|music/
# Rewrites data/*.json + MongoDB paths to ${R2_PUBLIC_URL}/img/...
#
# Fingerprint (Tarona / Shazam):
#   npm run fingerprints:generate          # bir martalik batch
#   FINGERPRINT_AUTO_SYNC=true             # create/update da avtomatik (default)
#
# After migration, prune local catalog copies (keeps UI chrome images):
#   npm run prune:public-media
#   npm run prune:public-media:execute
